#!/usr/bin/env python3
"""eco: ping a lot of things at once and understand it at a glance."""

import argparse, asyncio, bisect, ipaddress, json, os, re, shutil, signal, subprocess, sys, time

# ping comes out translated when the system locale is not English ("tiempo=" for
# "time="), so every subprocess is forced to the C locale: we parse its output,
# we don't read it.
ENV_C = {**os.environ, "LC_ALL": "C", "LANG": "C"}

def _xdg(var, defecto):
    base = os.environ.get(var) or os.path.expanduser(defecto)
    return base

def _conf_por_defecto():
    """~/.config/eco/conocidos.conf, salvo que ya exista ~/.config/lan con el
    mismo formato: varias herramientas de red comparten ese archivo, y pisar los
    nombres que el usuario ya tiene puestos sería peor que heredar el directorio."""
    base = _xdg("XDG_CONFIG_HOME", "~/.config")
    propio   = os.path.join(base, "eco", "conocidos.conf")
    heredado = os.path.join(base, "lan", "conocidos.conf")
    if not os.path.exists(propio) and os.path.exists(heredado):
        return heredado
    return propio

CONOCIDOS = (os.environ.get("ECO_CONF") or os.environ.get("LAN_CONF")
             or _conf_por_defecto())
ESTADO    = os.path.join(_xdg("XDG_CACHE_HOME", "~/.cache"), "eco", "ultimo.json")

