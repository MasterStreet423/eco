def color_ms(ms):
    """Verde rápido, ámbar tolerable, rojo lento. El umbral es LAN-céntrico."""
    if ms < 20:   return verde(f"{ms:6.1f} ms")
    if ms < 80:   return ambar(f"{ms:6.1f} ms")
    return rojo(f"{ms:6.1f} ms")

BLOQUES = "▁▂▃▄▅▆▇█"
# Cortes en ms para la escala ABSOLUTA (logarítmica, ~×2.7 por bloque: la
# latencia se mueve en órdenes de magnitud, no en pasos iguales). Es absoluta a
# propósito: escalar entre el mín y el máx de la ventana convierte un 0.4→0.5 ms
# en un "pico" enorme que no significa nada, y encima hace incomparables dos
# filas. Con esto, ▁ es siempre ~1 ms y █ es siempre un desastre.
ESCALA = [1.3, 3.6, 9.7, 26, 70, 190, 500]
RELATIVO = False        # -r vuelve al zoom automático de la ventana

def chispa(muestras, ancho=24):
    """Mini-gráfico de las últimas latencias; el paquete perdido va como ✗."""
    m = muestras[-ancho:]
    vivos = [x for x in m if x is not None]
    if not vivos: return rojo("✗" * len(m))
    if RELATIVO:
        lo, hi = min(vivos), max(vivos)
        span = (hi - lo) or 1.0
        nivel = lambda x: int((x - lo) / span * (len(BLOQUES) - 1))
    else:
        nivel = lambda x: bisect.bisect_left(ESCALA, x)
    return "".join(rojo("✗") if x is None else BLOQUES[nivel(x)] for x in m)

def leyenda_escala():
    return t("esc_rel") if RELATIVO else t("esc_abs")

# ── identidad de cada IP ─────────────────────────────────────────────────────
def leer_conocidos():
    """clave (MAC o IP) -> nombre, leído de conocidos.conf."""
    d = {}
    try:
        with open(CONOCIDOS) as f:
            for l in f:
                l = l.strip()
                if not l or l.startswith("#"): continue
                p = [x.strip() for x in l.split("|")]
                if len(p) >= 2 and p[0] and p[1]: d[p[0].upper()] = p[1]
    except FileNotFoundError: pass
    return d

def macs_arp():
    """IP -> MAC leyendo la tabla ARP, que los pings recién mandados calentaron.
    Solo existe para la LAN propia: al otro lado de un router no hay MAC."""
    out = {}
    try:
        salida = subprocess.run(["ip", "-4", "neigh", "show"], env=ENV_C,
                                capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return out
    for l in salida.splitlines():
        p = l.split()
        if "lladdr" in p and "FAILED" not in l:
            out[p[0]] = p[p.index("lladdr") + 1].upper()
    return out

def ips_propias():
    """Las IP de esta máquina: no tienen entrada ARP (uno no se pregunta a sí
    mismo por su propia MAC), así que sin esto salen con la columna vacía."""
    try:
        salida = subprocess.run(["ip", "-4", "-o", "addr", "show"], env=ENV_C,
                                capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return set()
    return {l.split()[3].split("/")[0] for l in salida.splitlines() if len(l.split()) > 3}

def aleatoria(mac):
    """MAC inventada por el equipo (Android/iOS/Windows desde ~2020): el 2º
    dígito es 2, 6, A o E. No sirve como identidad estable — se marca con ~."""
    return len(mac) > 1 and mac[1] in "26AE"

def prefijo_local():
    """Los tres primeros octetos de la IP de esta máquina, para que `.65` sea
    suficiente. Va por la ruta por defecto y no por la lista de IP a secas: con
    una VPN levantada esta máquina tiene varias, y la que importa es la de la
    red de verdad."""
    try:
        salida = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], env=ENV_C,
                                capture_output=True, text=True, timeout=5).stdout.split()
        if "src" in salida:
            return salida[salida.index("src") + 1].rsplit(".", 1)[0]
    except Exception:
        pass
    for ip in sorted(ips_propias()):
        if not ip.startswith("127."):
            return ip.rsplit(".", 1)[0]
    return None

def resolver(objetivo):
    """Un `.65`, una IP o un nombre -> (IP, error). El nombre va por `getent
    hosts` y no por socket: un subproceso sí se puede matar."""
    if objetivo.startswith("."):
        pre = prefijo_local()
        if not pre:
            return None, t("sin_ip_propia")
        objetivo = pre + objetivo
    try:
        return str(ipaddress.ip_address(objetivo)), None
    except ValueError:
        pass
    try:
        salida = subprocess.run(["getent", "hosts", objetivo], env=ENV_C,
                                capture_output=True, text=True, timeout=5).stdout.split()
        if salida:
            return salida[0], None
    except Exception:
        pass
    return None, t("no_resuelve", o=objetivo)

def mac_de(ip):
    """MAC de una IP. Si la ARP está fría le manda un ping para calentarla, que
    es justo lo que hace el barrido sin darse cuenta."""
    mac = macs_arp().get(ip)
    if mac:
        return mac
    subprocess.run(["ping", "-c", "1", "-W", "1", ip], env=ENV_C,
                   capture_output=True, timeout=3)
    return macs_arp().get(ip)

def apodar(objetivo, nombre):
    """`eco --nombrar 5 nombre` (fila del último barrido) o `eco --nombrar .65
    nombre` (IP o nombre directo, sin barrer antes)."""
    if objetivo.isdigit():
        try:
            est = json.load(open(ESTADO))
        except Exception:
            print(rojo(t("sin_barrido"))); print(dim(t("sin_barrido2"))); return 1
        filas = est.get("filas", [])
        pos = int(objetivo)
        if not (1 <= pos <= len(filas)):
            print(rojo(t("no_existe_fila", n=len(filas), p=pos))); return 1
        f = filas[pos - 1]
        ip, mac = f["ip"], f.get("mac")
    else:
        ip, err = resolver(objetivo)
        if err:
            print(rojo("  " + err)); return 1
        if ip in ips_propias():
            mac = None
        else:
            mac = mac_de(ip)
            if not mac:
                print(rojo(t("sin_arp", ip=ip)))
                print(dim(t("sin_arp2"))); print(dim(t("sin_arp3")))
    clave = (mac or ip).upper()
    porque = t("por_mac") if mac else t("por_ip")
    linea = f"{clave} | {nombre} | ? | {t('apodado')} {time.strftime('%F')}"
    os.makedirs(os.path.dirname(CONOCIDOS), exist_ok=True)
    try:
        lineas = open(CONOCIDOS).read().splitlines()
    except FileNotFoundError:
        lineas = [t("cabecera_conf")]
    for i, l in enumerate(lineas):
        if l.strip().upper().startswith(clave + " ") or l.split("|")[0].strip().upper() == clave:
            lineas[i] = linea; break
    else:
        lineas.append(linea)
    open(CONOCIDOS, "w").write("\n".join(lineas) + "\n")
    print(f"  {verde('✔')} {ip} {dim('(' + porque + ' ' + clave + ')')} → {bold(nombre)}")
    print(dim(t("guardado", f=CONOCIDOS)))
    return 0

# ── destinos ──────────────────────────────────────────────────────────────────
def expandir(arg):
    """Un argumento -> lista de destinos. CIDR, rangos, llaves o nombre pelado."""
    # llaves: 192.168.1.{1,2,3} o {1..10}  (solo llegan acá si venían comilladas)
    m = re.search(r"\{([^}]*)\}", arg)
    if m:
        piezas = []
        for parte in m.group(1).split(","):
            r = re.fullmatch(r"(\d+)\.\.(\d+)", parte.strip())
            if r:
                piezas += [str(n) for n in range(int(r.group(1)), int(r.group(2)) + 1)]
            elif parte.strip():
                piezas.append(parte.strip())
        out = []
        for p in piezas:
            out += expandir(arg[:m.start()] + p + arg[m.end():])
        return out
    # CIDR
    if "/" in arg:
        red = ipaddress.ip_network(arg, strict=False)
        if red.num_addresses <= 2:
            return [str(h) for h in red]
        return [str(h) for h in red.hosts()]
    # rango final: 192.168.1.10-40
    r = re.fullmatch(r"(.+\.)(\d+)-(\d+)", arg)
    if r:
        base, a, b = r.group(1), int(r.group(2)), int(r.group(3))
        return [f"{base}{n}" for n in range(a, min(b, 255) + 1)]
    return [arg]

# ── estado por destino ────────────────────────────────────────────────────────
class Host:
    def __init__(self, nombre, color):
        self.nombre, self.color = nombre, color
        self.enviados = self.recibidos = 0
        self.tiempos, self.serie, self.error = [], [], None
        self.seq = 0
    def etiqueta(self, ancho):
        return c(self.nombre.ljust(ancho), self.color)
    @property
    def perdidos(self): return self.enviados - self.recibidos
    @property
    def perdida(self):  return 100.0 * self.perdidos / self.enviados if self.enviados else 0.0

RE_OK   = re.compile(r"icmp_seq=(\d+).*?time=([\d.]+)\s*ms")
RE_NOOK = re.compile(r"no answer yet for icmp_seq=(\d+)")
RE_UNRE = re.compile(r"icmp_seq=(\d+).*?(Destination .*Unreachable|Time to live exceeded)")

# ── modo flujo ────────────────────────────────────────────────────────────────
# Una fila por destino que se redibuja en el sitio, en vez de scroll infinito:
# con 4 equipos a la vez el log vertical es ilegible — se pierde de vista quién
# es quién. Acá el ojo vuelve siempre a la misma línea. El historial no se
# pierde: vive en la chispa de la derecha.

class Pintor:
    """Redibuja N líneas en el mismo lugar subiendo el cursor. Nada de curses:
    esto tiene que poder convivir con un Ctrl-C y dejar la tabla en pantalla."""
    def __init__(self):
        self.n = 0
        if not PLANO: sys.stdout.write("\033[?25l")   # esconde el cursor

    def pinta(self, lineas):
        buf = [f"\033[{self.n}A"] if self.n else []
        for l in lineas: buf.append("\033[2K" + l + "\n")
        for _ in range(max(0, self.n - len(lineas))): buf.append("\033[2K\n")
        self.n = max(self.n, len(lineas))
        sys.stdout.write("".join(buf)); sys.stdout.flush()

    def cierra(self):
        if not PLANO: sys.stdout.write("\033[?25h"); sys.stdout.flush()

# La identidad (MAC + nombre de conocidos.conf) también sirve en el flujo, pero
# la tabla se repinta 5 veces por segundo: leer `ip neigh` en cada cuadro sería
# un subproceso cada 200 ms. Se refresca cada 5 s y se guarda acá.
_ident = {"t": 0.0, "arp": {}, "conocidos": {}, "propias": set()}

def identidad(h):
    """-> (nombre lindo o '', es_mío) para un destino del flujo."""
    if time.time() - _ident["t"] > 5:
        _ident.update(t=time.time(), arp=macs_arp(),
                      conocidos=leer_conocidos(), propias=ips_propias())
    n = h.nombre
    if n in _ident["propias"]: return t("esta_maquina"), True
    mac = _ident["arp"].get(n)
    if mac and mac in _ident["conocidos"]: return _ident["conocidos"][mac], True
    if n.upper() in _ident["conocidos"]:   return _ident["conocidos"][n.upper()], True
    return (mac or ""), False          # sin nombre, al menos muestra la MAC

def tabla_flujo(hosts, intervalo, t0):
    anc = min(max(max(len(h.nombre) for h in hosts), 12), 28)
    ident = {h.nombre: identidad(h) for h in hosts}
    anc_id = min(max((len(v[0]) for v in ident.values()), default=0), 18)
    cols = shutil.get_terminal_size((100, 24)).columns
    minmax = cols >= 92                     # en terminal angosta se cae esta columna
    usado = 4 + anc + 2 + 5 + 2 + 9 + 2 + 7 + 2 + 5 + (20 if minmax else 0) \
            + (anc_id + 2 if anc_id else 0)
    anc_ch = max(6, min(40, cols - usado - 3))

    cab = f"    {bold(t('destino').ljust(anc))}"
    if anc_id: cab += "  " + bold(t("quien").ljust(anc_id))
    cab += f"  {bold(t('seq'))}  {bold(t('ultimo'))}  {bold(t('paq'))}  {bold(t('perd'))}"
    if minmax: cab += "  " + bold(t("minmax").ljust(18))
    cab += "  " + bold(t("historial"))
    lineas = [cab, dim("  " + "─" * min(cols - 4, usado + anc_ch))]

    for h in hosts:
        if h.error:
            lineas.append(f"  {rojo('○')} {c(h.nombre.ljust(anc), h.color)}  {rojo(h.error[:cols-anc-8])}")
            continue
        ult = h.serie[-1] if h.serie else "nada"
        if ult == "nada":   punto, ultimo = dim("·"), dim(t("nada"))
        elif ult is None:   punto, ultimo = rojo("○"), rojo(t("perdido"))
        else:               punto, ultimo = verde("●"), color_ms(ult)
        p = h.perdida
        ptxt = f"{p:.0f}%".rjust(4)
        perd = verde(ptxt) if p == 0 else (ambar if p < 20 else rojo)(ptxt)
        fila = f"  {punto} {c(h.nombre.ljust(anc), h.color)}"
        if anc_id:
            nom, propio = ident[h.nombre]
            txt = nom[:anc_id].ljust(anc_id)
            fila += "  " + (cian(txt) if propio else dim(txt))
        fila += (f"  {dim(str(h.seq).rjust(5))}  {ultimo}  "
                 f"{dim(f'{h.recibidos}/{h.enviados}'.rjust(6))}  {perd}")
        if minmax:
            if h.tiempos:
                ts = sorted(h.tiempos)
                txt = f"{ts[0]:.1f}/{sum(ts)/len(ts):.1f}/{ts[-1]:.1f}"
            else:
                txt = "—"
            fila += "  " + dim(txt.ljust(18))
        fila += "  " + chispa(h.serie, anc_ch)
        lineas.append(fila)

    lineas.append(dim(t("pie_flujo", s=time.time()-t0, i=intervalo, esc=leyenda_escala())))
    return lineas

async def flujo(hosts, intervalo, cuenta, espera, tabla):
    ancho = min(max(max(len(h.nombre) for h in hosts), 12), 28)
    if not tabla:
        print(dim(t("cabecera_log", n=len(hosts), i=intervalo)))

    async def uno(h):
        cmd = ["ping", "-n", "-O", "-i", str(intervalo), "-W", str(espera), h.nombre]
        if cuenta: cmd[1:1] = ["-c", str(cuenta)]
        p = await asyncio.create_subprocess_exec(
            *cmd, env=ENV_C,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT)
        h.proc = p
        vistos = {}          # seq -> índice en la serie, para corregir tardíos
        while True:
            linea = await p.stdout.readline()
            if not linea: break
            txt = linea.decode(errors="replace").strip()
            m = RE_OK.search(txt)
            if m:
                seq, ms = int(m.group(1)), float(m.group(2))
                h.seq = seq; h.recibidos += 1; h.tiempos.append(ms)
                if seq in vistos:            # llegó tarde, tras el "sin respuesta"
                    h.serie[vistos[seq]] = ms
                    if not tabla:
                        print(f"{h.etiqueta(ancho)} {dim('seq')} {seq:<5} {color_ms(ms)}  {ambar(t('tardio'))}")
                else:
                    h.enviados += 1; h.serie.append(ms)
                    if not tabla:
                        print(f"{h.etiqueta(ancho)} {dim('seq')} {seq:<5} {color_ms(ms)}  {chispa(h.serie)}")
                continue
            m = RE_NOOK.search(txt) or RE_UNRE.search(txt)
            if m:
                seq = int(m.group(1))
                if seq in vistos: continue
                h.seq = seq; h.enviados += 1
                vistos[seq] = len(h.serie); h.serie.append(None)
                if not tabla:
                    motivo = t("sin_respuesta")
                    u = RE_UNRE.search(txt)
                    if u: motivo = u.group(2).lower()
                    print(f"{h.etiqueta(ancho)} {dim('seq')} {seq:<5} {rojo('  ✗ ' + motivo)}")
                continue
            m = re.search(r"(\d+) packets transmitted", txt)
            if m:                       # el total real lo dice ping al cerrar
                h.enviados = max(h.enviados, int(m.group(1)))
                continue
            if txt.startswith("ping:") or "unknown host" in txt or "Name or service" in txt:
                h.error = txt.replace("ping: ", "")
                if not tabla: print(f"{h.etiqueta(ancho)} {rojo('✗ ' + h.error)}")
        await p.wait()

    t0 = time.time()
    pintor = Pintor() if tabla else None

    async def pintar():
        while True:                     # 5 Hz: fluido sin parpadear ni gastar CPU
            pintor.pinta(tabla_flujo(hosts, intervalo, t0))
            await asyncio.sleep(0.2)

    tareas = [asyncio.ensure_future(uno(h)) for h in hosts]
    # el pintor va aparte del gather: es un bucle infinito, si entrara ahí
    # `eco -c 5` no terminaría nunca aunque los pings ya hayan acabado
    lapiz = asyncio.ensure_future(pintar()) if tabla else None
    try:
        await asyncio.gather(*tareas)
    except asyncio.CancelledError:
        pass
    finally:
        for tarea in tareas: tarea.cancel()
        if lapiz: lapiz.cancel()
        for h in hosts:
            p = getattr(h, "proc", None)
            if p and p.returncode is None:
                try: p.terminate()
                except ProcessLookupError: pass
        if pintor:
            pintor.pinta(tabla_flujo(hosts, intervalo, t0))   # última foto, ya quieta
            pintor.cierra()

def resumen_flujo(hosts):
    ancho = min(max(max(len(h.nombre) for h in hosts), 12), 28)
    print("\n" + bold(t("resumen")).ljust(60, "─" if not PLANO else "-"))
    for h in hosts:
        if h.error:
            print(f"{h.etiqueta(ancho)} {rojo(h.error)}"); continue
        if not h.enviados:
            print(f"{h.etiqueta(ancho)} {dim(t('sin_paquetes'))}"); continue
        p = h.perdida
        txt = t("perdida", p=p).ljust(13)
        est = verde(txt) if p == 0 else (ambar if p < 20 else rojo)(txt)
        if h.tiempos:
            ts = sorted(h.tiempos)
            prom = sum(ts) / len(ts)
            print(f"{h.etiqueta(ancho)} {h.recibidos}/{h.enviados} {t('paq_label')}  {est} "
                  f"{dim(t('minmax_label'))} {ts[0]:.1f}/{prom:.1f}/{ts[-1]:.1f} ms "
                  f"{dim(t('jitter'))} {max(ts)-min(ts):.1f}  {chispa(h.serie)}")
        else:
            print(f"{h.etiqueta(ancho)} {h.recibidos}/{h.enviados} {t('paq_label')}  {est}")

# ── modo barrido ──────────────────────────────────────────────────────────────
RE_STAT = re.compile(r"(\d+) packets transmitted, (\d+) received")
RE_RTT  = re.compile(r"= ([\d.]+)/([\d.]+)/([\d.]+)/")

async def dns_inverso(ips):
    """DNS inverso por `getent`, no por socket: un subproceso se puede matar,
    una llamada bloqueante al resolver del sistema no — y ahí se cuelga todo."""
    out = {}
    sem = asyncio.Semaphore(32)
    async def uno(ip):
        async with sem:
            try:
                p = await asyncio.create_subprocess_exec(
                    "getent", "hosts", ip, env=ENV_C,
                    stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
                salida, _ = await asyncio.wait_for(p.communicate(), 2.0)
                partes = salida.decode().split()
                if len(partes) > 1 and partes[1] != ip: out[ip] = partes[1]
            except asyncio.TimeoutError:
                try: p.kill()
                except ProcessLookupError: pass
            except Exception:
                pass
    await asyncio.gather(*(uno(ip) for ip in ips))
    return out

async def barrido(nombres, cuenta, espera, paralelo, nombres_dns, todos):
    sem = asyncio.Semaphore(paralelo)
    total, hechos, vivos = len(nombres), 0, []
    res = {}

    def progreso():
        if PLANO or not sys.stderr.isatty(): return
        ancho = min(shutil.get_terminal_size((80, 24)).columns - 34, 40)
        lleno = int(ancho * hechos / total)
        barra = c("━" * lleno, "38;5;81") + dim("━" * (ancho - lleno))
        sys.stderr.write(f"\r  {barra} {hechos}/{total}  {verde(str(len(vivos)) + ' ' + t('vivos'))}   ")
        sys.stderr.flush()

    async def uno(n):
        nonlocal hechos
        async with sem:
            p = await asyncio.create_subprocess_exec(
                "ping", "-n", "-q", "-c", str(cuenta), "-W", str(espera), "-i", "0.25", n,
                env=ENV_C,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
            salida = (await p.communicate())[0].decode(errors="replace")
        env = rec = 0
        m = RE_STAT.search(salida)
        if m: env, rec = int(m.group(1)), int(m.group(2))
        rtt = RE_RTT.search(salida)
        res[n] = dict(env=env, rec=rec, prom=float(rtt.group(2)) if rtt else None)
        if rec: vivos.append(n)
        hechos += 1; progreso()

    t0 = time.time()
    progreso()
    await asyncio.gather(*(uno(n) for n in nombres))
    if not PLANO and sys.stderr.isatty():
        sys.stderr.write("\r\033[2K"); sys.stderr.flush()

    arp        = macs_arp()
    propias    = ips_propias()
    conocidos  = leer_conocidos()
    dns        = await dns_inverso(vivos) if (nombres_dns and vivos) else {}

    def clave(n):
        try: return (0, int(ipaddress.ip_address(n)))
        except ValueError: return (1, n)
    filas = [n for n in sorted(nombres, key=clave) if res[n]["rec"] or todos]

    # el orden de la tabla es lo que después indexa `eco --nombrar N nombre`,
    # y vive en disco justamente para que sobreviva a un reinicio
    try:
        os.makedirs(os.path.dirname(ESTADO), exist_ok=True)
        json.dump({"fecha": time.strftime("%F %T"),
                   "filas": [{"ip": n, "mac": arp.get(n)} for n in filas]},
                  open(ESTADO, "w"))
    except OSError:
        pass

    if not filas:
        print(rojo(t("nadie", n=total)) + dim(f"({time.time()-t0:.1f}s)"))
        return

    def nombre_de(n):
        if n in propias: return t("esta_maquina"), True
        mac = arp.get(n)
        if mac and mac in conocidos: return conocidos[mac], True
        if n in conocidos:           return conocidos[n], True
        if n in dns:                 return dns[n], False
        return "", False

    if PLANO:
        for i, n in enumerate(filas, 1):
            r = res[n]
            print(f"{i}\t{n}\t{'up' if r['rec'] else 'down'}\t"
                  f"{r['prom'] if r['prom'] is not None else ''}\t{r['rec']}/{r['env']}\t"
                  f"{arp.get(n,'')}\t{nombre_de(n)[0]}")
        return

    anc_h = max(max(len(n) for n in filas), 9)
    anc_i = len(str(len(filas)))
    hay_mac = any(n in arp for n in filas)
    anc_m = 18 if hay_mac else 0
    anc_n = max((len(nombre_de(n)[0]) for n in filas), default=0)

    cab = (f"  {'#'.rjust(anc_i)}   {bold(t('destino').ljust(anc_h))}  "
           f"{bold(t('latencia').rjust(9))}  {bold(t('paq_corto'))}")
    if anc_m: cab += "  " + bold(t("mac").ljust(anc_m))
    if anc_n: cab += "  " + bold(t("nombre"))
    regla = dim("  " + "─" * (anc_i + anc_h + 22 + anc_m + anc_n))
    print(cab); print(regla)

    for i, n in enumerate(filas, 1):
        r = res[n]
        if r["rec"]:
            punto, lat = verde("●"), color_ms(r["prom"])   # ya viene de ancho fijo
            paq_txt = f"{r['rec']}/{r['env']}"
            paq = dim(paq_txt) if r["rec"] == r["env"] else ambar(paq_txt)
        else:
            punto, lat, paq = rojo("○"), dim("     —   "), rojo(f"0/{r['env']}")
        linea = f"  {dim(str(i).rjust(anc_i))} {punto} {n.ljust(anc_h)}  {lat}  {paq}"
        if anc_m:
            mac = arp.get(n, "")
            txt = (mac + ("~" if mac and aleatoria(mac) else "")).ljust(anc_m)
            linea += "  " + (dim(txt) if mac else txt)
        nom, propio = nombre_de(n)
        if nom: linea += "  " + (cian(nom) if propio else dim(nom))
        print(linea)

    print(regla)
    print(t("resumen_barrido", v=verde(str(len(vivos))), n=total) +
          dim(t("pie_barrido", s=time.time()-t0, c=cuenta)))
    if hay_mac:
        print(dim(t("leyenda_mac")) + dim(t("leyenda_apodo")) +
              bold(t("ej_nombrar_fila")) + dim(t("leyenda_apodo2")) +
              bold(t("ej_nombrar_ip")))

# ── main ──────────────────────────────────────────────────────────────────────
def construir_parser():
    ap = argparse.ArgumentParser(prog="eco", add_help=False, description=t("desc"))
    ap.add_argument("destinos", nargs="*")
    ap.add_argument("-c", "--cuenta", "--count", type=int, default=None, help=t("h_cuenta"))
    ap.add_argument("-i", "--intervalo", "--interval", type=float, default=1.0, help=t("h_intervalo"))
    ap.add_argument("-W", "--espera", "--wait", "--timeout", type=float, default=1.0, help=t("h_espera"))
    ap.add_argument("-p", "--paralelo", "--parallel", type=int, default=96, help=t("h_paralelo"))
    ap.add_argument("-b", "--barrido", "--sweep", "--scan", action="store_true", help=t("h_barrido"))
    ap.add_argument("-f", "--flujo", "--stream", "--live", action="store_true", help=t("h_flujo"))
    ap.add_argument("-t", "--todos", "--all", action="store_true", help=t("h_todos"))
    ap.add_argument("-n", "--dns", "--inverso", "--reverse", dest="nombres",
                    action="store_true", help=t("h_nombres"))
    ap.add_argument("--nombrar", "--name", dest="nombrar", nargs=2,
                    metavar=("DESTINO", "NOMBRE"), help=t("h_nombrar"))
    ap.add_argument("-r", "--relativo", "--relative", action="store_true", help=t("h_relativo"))
    ap.add_argument("-l", "--lineas", "--lines", "--log", action="store_true", help=t("h_lineas"))
    ap.add_argument("--plano", "--plain", action="store_true", help=t("h_plano"))
    ap.add_argument("--idioma", "--lang", default=None, help=t("h_idioma"))
    ap.add_argument("-h", "--ayuda", "--help", action="store_true")
    return ap

def main():
    global PLANO, RELATIVO, IDIOMA
    IDIOMA = elegir_idioma()
    PLANO = not sys.stdout.isatty() or bool(os.environ.get("NO_COLOR"))

    # --idioma tiene que aplicarse antes de construir el parser, porque hasta la
    # ayuda de cada flag sale de t(); por eso se lee a mano y no por argparse.
    args = sys.argv[1:]
    for i, a in enumerate(args):
        if a in ("--idioma", "--lang") and i + 1 < len(args):
            IDIOMA = elegir_idioma(args[i + 1])
        elif a.startswith(("--idioma=", "--lang=")):
            IDIOMA = elegir_idioma(a.split("=", 1)[1])

    a = construir_parser().parse_args()

    # --nombrar no pinga nada: hace su trabajo y se va, sin exigir destinos
    if a.nombrar:
        sys.exit(apodar(a.nombrar[0], a.nombrar[1]))

    if a.ayuda or not a.destinos:
        print(t("ayuda"), end="")
        sys.exit(0 if a.ayuda else 1)

    PLANO = a.plano or not sys.stdout.isatty() or bool(os.environ.get("NO_COLOR"))
    RELATIVO = a.relativo

    nombres, vistos = [], set()
    for d in a.destinos:
        for n in expandir(d):
            if n not in vistos: vistos.add(n); nombres.append(n)

    modo_flujo = a.flujo or (len(nombres) <= 12 and not a.barrido)
    if modo_flujo:
        hosts = [Host(n, PALETA[i % len(PALETA)]) for i, n in enumerate(nombres)]
        loop = asyncio.new_event_loop()
        tabla = not (a.lineas or PLANO)
        tarea = loop.create_task(flujo(hosts, a.intervalo, a.cuenta, a.espera, tabla))
        try:
            loop.run_until_complete(tarea)
        except KeyboardInterrupt:
            tarea.cancel()
            try: loop.run_until_complete(tarea)
            except (KeyboardInterrupt, asyncio.CancelledError): pass
        finally:
            loop.close()
        if not tabla:                # en tabla el resumen ya está en pantalla
            resumen_flujo(hosts)
    else:
        cuenta = a.cuenta or 2
        try:
            asyncio.run(barrido(nombres, cuenta, a.espera, a.paralelo, a.nombres, a.todos))
        except KeyboardInterrupt:
            print(rojo(t("cortado")))

if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL) if hasattr(signal, "SIGPIPE") else None
    main()
