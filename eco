IDIOMA = "es"

def elegir_idioma(forzado=None):
    """--idioma > ECO_LANG > locale > inglés. El locale se mira crudo y no con
    el módulo `locale`, que en un sistema sin configurar devuelve 'C' y nada más."""
    for cand in (forzado, os.environ.get("ECO_LANG"),
                 os.environ.get("LC_ALL"), os.environ.get("LC_MESSAGES"),
                 os.environ.get("LANG")):
        if not cand:
            continue
        cand = cand.lower()
        if cand.startswith("es"):
            return "es"
        if cand.startswith("en"):
            return "en"
        if forzado and cand == forzado.lower():
            return "en"      # idioma pedido pero desconocido: no adivinar
    return "en"

def t(clave, **kw):
    s = TEXTOS[IDIOMA][clave]
    return s.format(**kw) if kw else s

